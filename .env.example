# GEMINI_API_KEY: Required for Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CREDENTIAL_ENCRYPTION_KEY: Optional 32-byte hex or passphrase for encrypting stored 3P API credentials at rest.
# If omitted, a local server secret is derived and persisted safely outside client bundles.
CREDENTIAL_ENCRYPTION_KEY=""

# Optional Third-Party AI Provider Keys (can also be configured securely via AI Model Hub UI)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
XAI_API_KEY=""
